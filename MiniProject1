stack1 = []
stack2 = []

while True:
    print("\n1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        value = int(input("Enter value: "))
        stack1.append(value)
        print(value, "inserted")

    elif choice == 2:
        if not stack2:
            while stack1:
                stack2.append(stack1.pop())

        if not stack2:
            print("Queue is empty")
        else:
            print("Removed:", stack2.pop())

    elif choice == 3:
        if not stack1 and not stack2:
            print("Queue is empty")
        else:
            print("Queue:", stack2[::-1] + stack1)

    elif choice == 4:
        print("Program ended")
        break

    else:
        print("Invalid choice")
