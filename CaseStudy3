class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


# STACK

stack_top = None

def push(value):
    global stack_top

    new_node = Node(value)
    new_node.next = stack_top
    stack_top = new_node

    print(value, "inserted into stack")


def pop():
    global stack_top

    if stack_top is None:
        print("Stack is empty")
    else:
        print("Removed from stack:", stack_top.data)
        stack_top = stack_top.next


def display_stack():
    temp = stack_top

    print("Stack:", end=" ")

    while temp is not None:
        print(temp.data, end=" ")
        temp = temp.next

    print()


# QUEUE

front = None
rear = None

def enqueue(value):
    global front, rear

    new_node = Node(value)

    if front is None:
        front = rear = new_node
    else:
        rear.next = new_node
        rear = new_node

    print(value, "inserted into queue")


def dequeue():
    global front, rear

    if front is None:
        print("Queue is empty")
    else:
        print("Removed from queue:", front.data)
        front = front.next

        if front is None:
            rear = None


def display_queue():
    temp = front

    print("Queue:", end=" ")

    while temp is not None:
        print(temp.data, end=" ")
        temp = temp.next

    print()


while True:
    print("\n1. Push")
    print("2. Pop")
    print("3. Display Stack")
    print("4. Enqueue")
    print("5. Dequeue")
    print("6. Display Queue")
    print("7. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        value = int(input("Enter value: "))
        push(value)

    elif choice == "2":
        pop()

    elif choice == "3":
        display_stack()

    elif choice == "4":
        value = int(input("Enter value: "))
        enqueue(value)

    elif choice == "5":
        dequeue()

    elif choice == "6":
        display_queue()

    elif choice == "7":
        print("Program ended")
        break

    else:
        print("Invalid choice")
